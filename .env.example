# Application
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Comma-separated IPs allowed to send X-Forwarded-For (leave empty = trust none)
TRUSTED_PROXIES=
HEARTBEAT_ENABLED=true
HEARTBEAT_CHECK_INTERVAL=3600

# Database
DATABASE_URL=postgresql+psycopg://legacylock:legacylock@localhost:5432/legacylock_dev
POSTGRES_USER=legacylock
POSTGRES_PASSWORD=legacylock
POSTGRES_DB=legacylock_dev

# Sessions
# Generate with: openssl rand -base64 48 (must be >=32 chars, fail-closed if short)
SESSION_SECRET=generate-with-openssl-rand-base64-48-min-32-chars
SESSION_COOKIE_NAME_OWNER=legacylock_owner_session
SESSION_COOKIE_NAME_BENEFICIARY=legacylock_beneficiary_session

# JWT RS256 Keys (paths are relative to backend/)
# Generate with: openssl genrsa -out backend/keys/jwt_private.pem 2048 && openssl rsa -in backend/keys/jwt_private.pem -pubout -out backend/keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# Notifications (optional; mock-logged when empty)
# SENDGRID_API_KEY=
# NOTIFICATION_EMAIL_FROM=noreply@legacylock.app
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# pgAdmin (local dev only)
PGADMIN_EMAIL=admin@legacylock.local
PGADMIN_PASSWORD=admin