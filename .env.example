# Application
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Comma-separated IPs allowed to send X-Forwarded-For (leave empty = trust none)
TRUSTED_PROXIES=
HEARTBEAT_ENABLED=true
HEARTBEAT_CHECK_INTERVAL=60

# Database
DATABASE_URL=postgresql+psycopg://legacylock:legacylock@localhost:5432/legacylock_dev
POSTGRES_USER=legacylock
POSTGRES_PASSWORD=legacylock
POSTGRES_DB=legacylock_dev

# Sessions
# Generate with: openssl rand -base64 48 (must be >=32 chars, fail-closed if short)
SESSION_SECRET=generate-with-openssl-rand-base64-48-min-32-chars
SESSION_COOKIE_NAME_OWNER=legacylock_owner_session
SESSION_COOKIE_NAME_OWNER_REFRESH=legacylock_owner_refresh
SESSION_COOKIE_NAME_BENEFICIARY=legacylock_beneficiary_session
SESSION_COOKIE_NAME_BENEFICIARY_REFRESH=legacylock_beneficiary_refresh

# JWT RS256 Keys (paths are relative to backend/)
# Generate with: openssl genrsa -out backend/keys/jwt_private.pem 2048 && openssl rsa -in backend/keys/jwt_private.pem -pubout -out backend/keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# Gated self-service registration (B-spec): empty = disabled (fail-closed).
# Generate with: openssl rand -hex 16. Distribute out-of-band; rotation = new value + restart.
REGISTRATION_INVITE_CODE=
# Real Resend is mandatory in production; development suppresses delivery without logging bodies.
# Staging can use the Resend sandbox sender (onboarding@resend.dev, verified
# recipient only); prod needs a verified custom domain (SPF/DKIM/DMARC).
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=noreply@legacylock.app
EMAIL_VERIFICATION_TTL_HOURS=24
# SMS is optional and disabled unless explicitly enabled with valid credentials.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# pgAdmin (local dev only)
PGADMIN_EMAIL=admin@legacylock.local
PGADMIN_PASSWORD=admin

# ── PRODUCTION (managed PaaS + managed Postgres + same-origin — see DEPLOY.md) ──
# Copy these into your platform's secret store (never commit a real .env).
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/legacylock_prod?sslmode=verify-full
# SESSION_SECRET=<openssl rand -base64 48>
# ALLOWED_ORIGINS=https://app.example.com
# FRONTEND_URL=https://app.example.com
# TRUSTED_PROXIES=<load-balancer CIDRs, comma-separated>
# Start Uvicorn with --no-proxy-headers; application TRUSTED_PROXIES owns forwarding trust.
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
# HEARTBEAT_ENABLED=true
# Frontend image build-arg (baked at build time; empty = same-origin /api):
# NEXT_PUBLIC_API_URL=
# Remediation operational controls
ALLOWED_HOSTS=localhost,127.0.0.1
BACKGROUND_IN_API=true
RELEASE_HOLD=false
DELIVERY_ENABLED=true
# Dedicated AES-GCM 32-byte base64 key, mandatory in production.
DELIVERY_PAYLOAD_KEY=
DELIVERY_PAYLOAD_KEY_ID=v1
# JSON map of retained old payload key IDs to base64 keys; secret store only.
DELIVERY_PAYLOAD_KEYS={}
AUTH_EPOCH=initial
OPERATIONS_TOKEN=
SMS_ENABLED=false
# Same-origin frontend proxy destination (set before building Next).
API_UPSTREAM=http://localhost:8000
NEXT_PUBLIC_API_URL=
