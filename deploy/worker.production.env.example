# Render private worker service. Populate blanks in its secret store.
# Share database, release controls, auth epoch, delivery key ring, and sender with the API.
# JWT signing keys and registration invite code are not needed by this process.
# Use the same direct Neon DATABASE_URL as the API, with sslmode=verify-full.
# Retain channel_binding=require from Neon; verify the system CA bundle path.
ENVIRONMENT=production
DATABASE_URL=
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
SESSION_SECRET=
AUTH_EPOCH=
ALLOWED_ORIGINS=
FRONTEND_URL=
ALLOWED_HOSTS=
TRUSTED_PROXIES=
BACKGROUND_IN_API=false
HEARTBEAT_ENABLED=true
RELEASE_HOLD=true
DELIVERY_ENABLED=false
SMS_ENABLED=false
DELIVERY_PAYLOAD_KEY=
DELIVERY_PAYLOAD_KEY_ID=v1
DELIVERY_PAYLOAD_KEYS={}
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
