# Render API service. Populate blanks in its secret store; do not deploy this file.
# Use the direct Neon connection string for the initial fixed-size API/worker setup.
# Replace sslmode=require with sslmode=verify-full; retain channel_binding=require.
# The image installs system CA roots; verify the bundle path in the final image.
ENVIRONMENT=production
DATABASE_URL=
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
SESSION_SECRET=
AUTH_EPOCH=
# Supply matching RSA PEMs as base64 secrets, or mount files and use JWT_*_KEY_PATH.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ALLOWED_ORIGINS=
FRONTEND_URL=
ALLOWED_HOSTS=
TRUSTED_PROXIES=
BACKGROUND_IN_API=false
# Choose single_process_demo only for the synthetic, single-API Render Free demo.
# Leave separate_worker for the dedicated-worker deployment described in DEPLOY.md.
TASK_MODE=separate_worker
DEMO_CHECK_INTERVAL_SECONDS=1800
DEMO_DELIVERY_BATCH_SIZE=5
DEMO_ARGON2_CONCURRENCY=1
HEARTBEAT_ENABLED=true
RELEASE_HOLD=true
DELIVERY_ENABLED=false
SMS_ENABLED=false
DELIVERY_PAYLOAD_KEY=
DELIVERY_PAYLOAD_KEY_ID=v1
DELIVERY_PAYLOAD_KEYS={}
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
# Generate independently with openssl rand -base64 48 (minimum 32 characters).
OPERATIONS_TOKEN=
# Empty disables enrollment until the code has been distributed out of band.
REGISTRATION_INVITE_CODE=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
