# Current Render Free + Neon Free deployment: one API service, no separate worker.
# Populate blanks in Render's secret store; never deploy this file as a populated artifact.
# Run migrations separately from a trusted local or CI environment before deploying.
ENVIRONMENT=production
TASK_MODE=single_process_demo
BACKGROUND_IN_API=false
DEMO_CHECK_INTERVAL_SECONDS=1800
DEMO_DELIVERY_BATCH_SIZE=5
DEMO_ARGON2_CONCURRENCY=1
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DATABASE_URL=
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
SESSION_SECRET=
AUTH_EPOCH=
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ALLOWED_ORIGINS=
FRONTEND_URL=
ALLOWED_HOSTS=
TRUSTED_PROXIES=
HEARTBEAT_ENABLED=true
RELEASE_HOLD=true
DELIVERY_ENABLED=false
DELIVERY_PAYLOAD_KEY=
DELIVERY_PAYLOAD_KEY_ID=v1
DELIVERY_PAYLOAD_KEYS={}
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
OPERATIONS_TOKEN=
REGISTRATION_INVITE_CODE=
